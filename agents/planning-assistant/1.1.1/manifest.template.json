{
  "apiVersion": "porfirium.ai/v1",
  "kind": "Agent",
  "metadata": {
    "name": "planning-assistant",
    "version": "1.1.1",
    "displayName": "Planning Assistant",
    "description": "Planning assistant grounded with the delegated read-only current-time tool"
  },
  "spec": {
    "image": "${IMAGE}",
    "entrypoint": "planning_assistant:main",
    "sdk": ">=1.0.0,<2.0.0",
    "models": ["default"],
    "tools": ["time_get_current_time"],
    "configSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "additionalProperties": false
    },
    "resources": {
      "cpu": "500m",
      "memory": "128Mi",
      "timeoutSeconds": 240
    }
  }
}
