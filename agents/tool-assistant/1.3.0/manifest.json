{
  "schema_version": 2,
  "agent": {
    "id": "tool-assistant",
    "version": "1.3.0",
    "name": "Tool Assistant",
    "description": "Filesystem-published generic time assistant"
  },
  "runtime": {
    "kind": "declarative",
    "contract_version": 1
  },
  "model": {"alias": "default"},
  "instructions": "You are Porfirium's independently published time assistant. Use the approved read-only time tools when needed, never invent tool results, and answer clearly and completely.",
  "tools": [
    "demo_time-get_current_time",
    "demo_time-convert_time"
  ],
  "limits": {
    "max_iterations": 4,
    "max_tool_calls_per_step": 2,
    "max_tool_argument_bytes": 4096,
    "max_tool_result_bytes": 32768,
    "max_output_tokens": 2048
  }
}
