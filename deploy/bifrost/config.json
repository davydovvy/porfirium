{
  "$schema": "https://www.getbifrost.ai/schema",
  "client": {
    "mcp_disable_auto_tool_inject": true
  },
  "providers": {
    "yandex": {
      "keys": [
        {
          "name": "yandex-phase0",
          "value": "env.YANDEX_API_KEY",
          "models": ["*"],
          "weight": 1.0
        }
      ],
      "network_config": {
        "base_url": "https://ai.api.cloud.yandex.net/v1",
        "default_request_timeout_in_seconds": 90,
        "max_retries": 1
      },
      "custom_provider_config": {
        "base_provider_type": "openai",
        "allowed_requests": {
          "list_models": false,
          "chat_completion": true,
          "chat_completion_stream": true,
          "responses": true,
          "responses_stream": true
        },
        "request_path_overrides": {
          "chat_completion": "https://ai.api.cloud.yandex.net/v1/chat/completions",
          "chat_completion_stream": "https://ai.api.cloud.yandex.net/v1/chat/completions",
          "responses": "https://ai.api.cloud.yandex.net/v1/responses",
          "responses_stream": "https://ai.api.cloud.yandex.net/v1/responses"
        }
      },
      "send_back_raw_request": false,
      "send_back_raw_response": false
    }
  },
  "mcp": {
    "client_configs": [
      {
        "client_id": "phase0_diagnostic",
        "name": "phase0_diagnostic",
        "connection_type": "http",
        "connection_string": "http://diagnostic-mcp:8091/mcp/",
        "auth_type": "none",
        "is_ping_available": true,
        "allow_on_all_virtual_keys": true,
        "tools_to_execute": ["echo", "platform_info"]
      }
    ],
    "tool_manager_config": {
      "max_agent_depth": 4,
      "tool_execution_timeout": "15s",
      "code_mode_binding_level": "server"
    }
  },
  "plugins": [
    {
      "enabled": true,
      "name": "otel",
      "version": 2,
      "config": {
        "profiles": [
          {
            "enabled": true,
            "service_name": "bifrost-phase0",
            "collector_url": "http://langfuse-web:3000/api/public/otel/v1/traces",
            "trace_type": "genai_extension",
            "protocol": "http",
            "headers": {
              "Authorization": "env.LANGFUSE_AUTH",
              "x-langfuse-ingestion-version": "4"
            }
          }
        ]
      }
    }
  ]
}
