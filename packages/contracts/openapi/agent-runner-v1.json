{
  "openapi": "3.1.0",
  "info": {"title": "Porfirium Agent Runner API", "version": "1.0.0"},
  "servers": [{"url": "/v1"}],
  "security": [{"serviceOAuth": []}],
  "paths": {
    "/runs": {
      "post": {
        "operationId": "admitRun",
        "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RunAdmission"}}}},
        "responses": {
          "202": {"description": "Run admitted", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Run"}}}},
          "default": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/runs/{run_id}": {
      "get": {
        "operationId": "getRun",
        "parameters": [{"$ref": "#/components/parameters/RunId"}],
        "responses": {
          "200": {"description": "Authoritative run lifecycle", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Run"}}}},
          "default": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/runs/{run_id}:cancel": {
      "post": {
        "operationId": "cancelRun",
        "parameters": [{"$ref": "#/components/parameters/RunId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "responses": {
          "202": {"description": "Cancellation accepted or already resolved", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Run"}}}},
          "default": {"$ref": "#/components/responses/Problem"}
        }
      }
    },
    "/health/live": {"get": {"security": [], "operationId": "liveness", "responses": {"200": {"description": "Process is live"}}}},
    "/health/ready": {"get": {"security": [], "operationId": "readiness", "responses": {"200": {"description": "Required dependencies are ready"}, "503": {"description": "A required dependency is unavailable"}}}}
  },
  "components": {
    "securitySchemes": {"serviceOAuth": {"type": "oauth2", "flows": {"clientCredentials": {"tokenUrl": "https://keycloak.local/token", "scopes": {}}}}},
    "parameters": {
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}},
      "RunId": {"name": "run_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}
    },
    "responses": {"Problem": {"description": "Bounded machine-readable error", "content": {"application/problem+json": {"schema": {"$ref": "../http/problem-v1.schema.json"}}}}},
    "schemas": {
      "RunAdmission": {
        "type": "object",
        "required": ["run_id", "user_id", "conversation_id", "thread_id", "release_id", "delegation_grant_id", "trigger", "trace_id"],
        "additionalProperties": false,
        "properties": {
          "run_id": {"type": "string", "format": "uuid"}, "user_id": {"type": "string", "format": "uuid"},
          "conversation_id": {"type": "string", "format": "uuid"}, "thread_id": {"type": "string", "format": "uuid"},
          "release_id": {"type": "string", "format": "uuid"}, "delegation_grant_id": {"type": "string", "format": "uuid"},
          "configuration_revision_id": {"type": ["string", "null"], "format": "uuid"},
          "starting_checkpoint_id": {"type": ["string", "null"], "format": "uuid"},
          "trigger": {
            "type": "object", "required": ["type", "id"], "additionalProperties": false,
            "properties": {"type": {"enum": ["user_message", "user_response", "resume"]}, "id": {"type": "string", "format": "uuid"}}
          },
          "trace_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"}
        }
      },
      "Run": {
        "type": "object", "required": ["run_id", "state", "lease_epoch", "created_at", "updated_at"], "additionalProperties": false,
        "properties": {
          "run_id": {"type": "string", "format": "uuid"},
          "state": {"enum": ["requested", "accepted", "scheduled", "starting", "running", "suspending", "waiting_for_input", "completion_reconciling", "cancelling", "completed", "failed", "cancelled"]},
          "active_attempt_id": {"type": ["string", "null"], "format": "uuid"},
          "lease_epoch": {"type": "integer", "minimum": 0},
          "terminal_code": {"type": ["string", "null"], "maxLength": 64},
          "created_at": {"type": "string", "format": "date-time"}, "updated_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
