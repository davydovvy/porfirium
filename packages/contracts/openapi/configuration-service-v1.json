{
  "openapi": "3.1.0", "info": {"title": "Porfirium Configuration Service API", "version": "1.0.0"}, "servers": [{"url": "/v1"}], "security": [{"serviceOAuth": []}],
  "paths": {
    "/revisions": {"post": {"operationId": "createConfigurationRevision", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateRevision"}}}}, "responses": {"201": {"description": "Immutable configuration revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Revision"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/revisions/{revision_id}": {"get": {"operationId": "getConfigurationRevision", "parameters": [{"name": "revision_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}], "responses": {"200": {"description": "Authorized immutable revision", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Revision"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/effective-configurations:resolve": {"post": {"operationId": "resolveEffectiveConfiguration", "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ResolveConfiguration"}}}}, "responses": {"200": {"description": "Validated pinned non-secret configuration", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EffectiveConfiguration"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}}
  },
  "components": {
    "securitySchemes": {"serviceOAuth": {"type": "oauth2", "flows": {"clientCredentials": {"tokenUrl": "https://keycloak.local/token", "scopes": {}}}}},
    "parameters": {"IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}}},
    "responses": {"Problem": {"description": "Bounded error", "content": {"application/problem+json": {"schema": {"$ref": "../http/problem-v1.schema.json"}}}}},
    "schemas": {
      "CreateRevision": {"type": "object", "required": ["release_id", "scope", "schema_digest", "values"], "additionalProperties": false, "properties": {"release_id": {"type": "string", "format": "uuid"}, "scope": {"enum": ["user", "conversation"]}, "conversation_id": {"type": ["string", "null"], "format": "uuid"}, "schema_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "values": {"type": "object"}, "secret_references": {"type": "object"}}},
      "Revision": {"type": "object", "required": ["revision_id", "release_id", "scope", "schema_digest", "values", "created_at"], "additionalProperties": false, "properties": {"revision_id": {"type": "string", "format": "uuid"}, "release_id": {"type": "string", "format": "uuid"}, "scope": {"enum": ["user", "conversation"]}, "conversation_id": {"type": ["string", "null"], "format": "uuid"}, "schema_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "values": {"type": "object"}, "secret_references": {"type": "object"}, "created_at": {"type": "string", "format": "date-time"}}},
      "ResolveConfiguration": {"type": "object", "required": ["release_id", "schema", "schema_digest", "release_defaults"], "additionalProperties": false, "properties": {"release_id": {"type": "string", "format": "uuid"}, "schema": {"type": "object"}, "schema_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "release_defaults": {"type": "object"}, "user_revision_id": {"type": ["string", "null"], "format": "uuid"}, "conversation_revision_id": {"type": ["string", "null"], "format": "uuid"}}},
      "EffectiveConfiguration": {"type": "object", "required": ["effective_revision_id", "schema_digest", "values", "secret_references", "content_sha256"], "additionalProperties": false, "properties": {"effective_revision_id": {"type": "string", "format": "uuid"}, "schema_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "values": {"type": "object"}, "secret_references": {"type": "object"}, "content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}
    }
  }
}
