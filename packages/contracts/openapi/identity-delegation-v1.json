{
  "openapi": "3.1.0", "info": {"title": "Porfirium Identity Delegation API", "version": "1.0.0"}, "servers": [{"url": "/v1"}], "security": [{"serviceOAuth": []}],
  "paths": {
    "/delegation-grants": {"post": {"operationId": "createDelegationGrant", "security": [{"userOAuth": []}], "parameters": [{"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateGrant"}}}}, "responses": {"201": {"description": "Opaque non-secret grant reference", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Grant"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/delegation-grants/{grant_id}:exchange": {"post": {"operationId": "exchangeDelegationGrant", "security": [{"serviceOAuth": []}, {"runCapability": []}], "parameters": [{"$ref": "#/components/parameters/GrantId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExchangeGrant"}}}}, "responses": {"200": {"description": "Short-lived MCP-audience token for the exact active attempt", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DelegatedToken"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/delegation-grants/{grant_id}:renew": {"post": {"operationId": "renewDelegatedToken", "security": [{"serviceOAuth": []}, {"runCapability": []}], "parameters": [{"$ref": "#/components/parameters/GrantId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ExchangeGrant"}}}}, "responses": {"200": {"description": "Replacement short-lived token", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/DelegatedToken"}}}}, "default": {"$ref": "#/components/responses/Problem"}}}},
    "/delegation-grants/{grant_id}:revoke": {"post": {"operationId": "revokeDelegationGrant", "parameters": [{"$ref": "#/components/parameters/GrantId"}, {"$ref": "#/components/parameters/IdempotencyKey"}], "responses": {"204": {"description": "Grant revoked or already revoked"}, "default": {"$ref": "#/components/responses/Problem"}}}}
  },
  "components": {
    "securitySchemes": {"serviceOAuth": {"type": "oauth2", "flows": {"clientCredentials": {"tokenUrl": "https://keycloak.local/token", "scopes": {}}}}, "runCapability": {"type": "apiKey", "in": "header", "name": "X-Run-Capability", "description": "Exact signed active-attempt capability; accepted only on internal exchange and renewal paths"}, "userOAuth": {"type": "oauth2", "description": "User authorization accepted only at the BFF/delegation boundary", "flows": {"authorizationCode": {"authorizationUrl": "https://keycloak.local/authorize", "tokenUrl": "https://keycloak.local/token", "scopes": {}}}}},
    "parameters": {"IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "schema": {"type": "string", "minLength": 8, "maxLength": 128}}, "GrantId": {"name": "grant_id", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}}},
    "responses": {"Problem": {"description": "Bounded error", "content": {"application/problem+json": {"schema": {"$ref": "../http/problem-v1.schema.json"}}}}},
    "schemas": {
      "CreateGrant": {"type": "object", "required": ["conversation_id", "release_id", "maximum_scopes"], "additionalProperties": false, "properties": {"conversation_id": {"type": "string", "format": "uuid"}, "release_id": {"type": "string", "format": "uuid"}, "maximum_scopes": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}}}},
      "Grant": {"type": "object", "required": ["grant_id", "conversation_id", "release_id", "maximum_scopes", "expires_at", "revoked"], "additionalProperties": false, "properties": {"grant_id": {"type": "string", "format": "uuid"}, "conversation_id": {"type": "string", "format": "uuid"}, "release_id": {"type": "string", "format": "uuid"}, "maximum_scopes": {"type": "array", "items": {"type": "string"}}, "expires_at": {"type": "string", "format": "date-time"}, "revoked": {"type": "boolean"}}},
      "ExchangeGrant": {"type": "object", "required": ["run_id", "attempt_id", "lease_epoch", "audience", "scopes"], "additionalProperties": false, "properties": {"run_id": {"type": "string", "format": "uuid"}, "attempt_id": {"type": "string", "format": "uuid"}, "lease_epoch": {"type": "integer", "minimum": 1}, "audience": {"const": "porfirium-mcp-gateway"}, "scopes": {"type": "array", "maxItems": 64, "items": {"type": "string", "maxLength": 128}}}},
      "DelegatedToken": {"type": "object", "required": ["access_token", "token_type", "expires_at", "audience", "scopes"], "additionalProperties": false, "properties": {"access_token": {"type": "string", "minLength": 1}, "token_type": {"const": "Bearer"}, "expires_at": {"type": "string", "format": "date-time"}, "audience": {"const": "porfirium-mcp-gateway"}, "scopes": {"type": "array", "items": {"type": "string"}}}}
    }
  }
}
